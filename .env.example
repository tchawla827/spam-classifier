# ============================================================
# spam-classifier — environment variable reference
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ------------------------------------
# Backend API
# ------------------------------------
# Base URL for the API server (used by frontend to call backend)
API_BASE_URL=http://localhost:8000

# Active model version identifier (must match exported artifact metadata)
MODEL_VERSION=email-spam-v1.0.0

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ------------------------------------
# Frontend
# ------------------------------------
# Public API URL exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------
# CORS (Backend)
# ------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ------------------------------------
# Database (optional in V1, required for Phase 11+)
# ------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/spam_classifier

# ------------------------------------
# Gmail OAuth (Phase 14+ only — do not populate in V1)
# ------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# TOKEN_ENCRYPTION_KEY=
