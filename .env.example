# ============================================================
# spam-classifier - environment variable reference
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ------------------------------------
# Backend API
# ------------------------------------
# Base URL for the API server (used by frontend to call backend)
API_BASE_URL=http://localhost:8000

# Active model version identifier (must match exported artifact metadata)
MODEL_VERSION=email-spam-v1.0.0

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ------------------------------------
# Frontend
# ------------------------------------
# Public API URL exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------
# CORS (Backend)
# ------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ------------------------------------
# Database (optional - omit to disable persistence)
# ------------------------------------
# Local development:
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/spam_classifier
# Supabase free tier (production): get from Supabase dashboard -> Settings -> Database -> URI
# Replace "postgres://" with "postgresql+asyncpg://" in the URI
# DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ------------------------------------
# Production (Vercel + Render)
# ------------------------------------
# Set NEXT_PUBLIC_API_URL in Vercel project settings (not in this file)
# NEXT_PUBLIC_API_URL=https://spam-classifier-api.onrender.com
#
# Set the following in Render dashboard environment variables:
# CORS_ORIGINS=https://your-app.vercel.app
# FRONTEND_URL=https://your-app.vercel.app
# SESSION_COOKIE_SAMESITE=none
# DATABASE_URL=postgresql+asyncpg://postgres:[pw]@db.[ref].supabase.co:5432/postgres

# ------------------------------------
# Google Auth (optional)
# ------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# TOKEN_ENCRYPTION_KEY=

# ------------------------------------
# Gmail OAuth (Phase 14+ only - do not populate in V1)
# ------------------------------------
# Gmail integration reads credentials from environment variables.
# Do not keep downloaded OAuth JSON files or ad hoc password files in the repo root.
# For local work, copy values from Google Cloud and your DB provider into `.env`.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/gmail/connect/callback
